generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  emailVerified   DateTime?
  passwordHash    String
  image           String?
  personalityType String?    @map("personality_type")
  weeklyTarget    Int        @default(3) @map("weekly_target")
  lastWorkoutAt   DateTime?  @map("last_workout_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  workouts          Workout[]
  sentRequests      Friendship[]            @relation("UserFriends")
  receivedRequests  Friendship[]            @relation("UserFriendOf")
  feedItems         FeedItem[]
  interactions      Interaction[]
  buddyParticipants BuddySessionParticipant[]

  @@map("users")
}

model Workout {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  type           String
  duration       Int
  distance       Float?
  source         String   @default("manual")
  recordedAt     DateTime @default(now()) @map("recorded_at")
  createdAt      DateTime @default(now()) @map("created_at")
  buddySessionId String?  @map("buddy_session_id")

  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  buddySession BuddySession?             @relation(fields: [buddySessionId], references: [id])
  participants BuddySessionParticipant[]

  @@index([userId, recordedAt])
  @@map("workouts")
}

model BuddySession {
  id          String   @id @default(cuid())
  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")
  status      String   @default("pending") // pending / active / completed / expired
  createdAt   DateTime @default(now()) @map("created_at")

  workouts     Workout[]
  participants BuddySessionParticipant[]

  @@map("buddy_sessions")
}

model BuddySessionParticipant {
  id        String    @id @default(cuid())
  sessionId String    @map("session_id")
  userId    String    @map("user_id")
  joinedAt  DateTime? @map("joined_at")
  workoutId String?   @map("workout_id")

  session BuddySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout?     @relation(fields: [workoutId], references: [id])

  @@unique([sessionId, userId])
  @@map("buddy_session_participants")
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("UserFriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friendships")
}

model FeedItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String   // workout / buddy_workout
  content   Json
  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@index([userId, createdAt])
  @@map("feed_items")
}

model Interaction {
  id         String  @id @default(cuid())
  feedItemId String  @map("feed_item_id")
  userId     String  @map("user_id")
  type       String  // like / comment / witness
  content    String?
  createdAt  DateTime @default(now()) @map("created_at")

  feedItem FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedItemId, userId, type])
  @@index([feedItemId])
  @@map("interactions")
}
